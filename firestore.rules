rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function roomPath() { return /databases/$(database)/documents/pocket_space/plant_state; }
    function ppaPath() { return /databases/$(database)/documents/pocket_space/user_ppa; }
    function tbvPath() { return /databases/$(database)/documents/pocket_space/user_tbv; }
    function roomAfter() { return getAfter(roomPath()).data; }
    function sameRoomWrite(revision) {
      return roomAfter().revision == revision
        && (exists(roomPath()) ? get(roomPath()).data.revision + 1 == revision : revision == 1);
    }
    function validProfile(data, role) {
      return data.id == role && data.currentActivity is string
        && data.sessionVersion is int && data.sessionVersion >= 0
        && (data.lastActivityTimestamp == null || (data.lastActivityTimestamp is int
          && data.lastActivityTimestamp <= request.time.toMillis() + 120000))
        && data.waterDropsToday is int && data.waterDropsToday >= 0
        && data.waterToday == data.waterDropsToday && data.questsDone is list
        && data.lastActive == request.time
        && ((data.currentActivity == 'home_idle' && data.startTime == null)
          || (data.currentActivity != 'home_idle' && data.startTime is int
            && data.startTime <= request.time.toMillis() + 120000));
    }
    function mirrored(data, role) {
      let room = roomAfter();
      return sameRoomWrite(room.revision)
        && data.diff(room.users[role]).affectedKeys().hasOnly(['waterToday', 'questsDone', 'lastActive']);
    }
    function validSessionChange(before, after, role) {
      let changed = after.diff(before).affectedKeys();
      return after.sessionVersion >= before.sessionVersion
        && (before.lastActivityTimestamp == null || after.lastActivityTimestamp >= before.lastActivityTimestamp)
        && (!changed.hasAny(['currentActivity', 'startTime', 'plannedEndTime',
                            'explicitSession', 'sessionVersion', 'lastActivityTimestamp', 'sessionId'])
          || roomAfter().actor == role
          || (before.plannedEndTime is int
            && before.plannedEndTime <= request.time.toMillis() + 120000
            && after.currentActivity == 'home_idle' && after.startTime == null
            && after.lastActivityTimestamp == before.plannedEndTime
            && after.sessionVersion == before.sessionVersion + 1));
    }
    function historyPreserved(before, after, liveDate) {
      let changes = after.diff(before);
      return changes.removedKeys().size() == 0 && changes.changedKeys().hasOnly([liveDate]);
    }
    function validWaterTarget(data, canRetainLegacyTarget) {
      let plant = data.plant;
      let version = plant.get('balanceVersion', 0);
      let growthDays = plant.get('stageGrowthDays', 0);
      let stage = data.currentStage - 1;
      let legacy = data.targetWater in [40, 55, 70, 85, 100];
      let expected = [48, 69, 90, 111, 186][stage] + [1, 1, 1, 2, 0][stage] * growthDays;
      return data.targetWater is int && data.targetWater == plant.targetDrops
        && ((version < 1 && legacy) || (version >= 1
          && growthDays is int && growthDays >= 0 && growthDays <= 20
          && (stage < 4 || growthDays == 0)
          && (data.targetWater == expected || (legacy && canRetainLegacyTarget))));
    }
    function validRoom(data, canRetainLegacyTarget) {
      return data.actor in ['ppa', 'tbv', 'system'] && data.revision is int && data.revision > 0
        && data.clientEvaluatedAt is timestamp && data.clientEvaluatedAt <= request.time + duration.value(2, 'm')
        && data.updatedAt == request.time && data.plant is map
        && data.currentStage is int && data.currentStage >= 1 && data.currentStage <= 5
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 21
        && validWaterTarget(data, canRetainLegacyTarget)
        && data.messages is list && data.messages.size() <= 160
        && getAfter(ppaPath()).data.diff(data.users.ppa).affectedKeys().hasOnly(['waterToday', 'questsDone', 'lastActive'])
        && getAfter(tbvPath()).data.diff(data.users.tbv).affectedKeys().hasOnly(['waterToday', 'questsDone', 'lastActive']);
    }

    match /pocket_space/plant_state {
      allow get: if true;
      allow create: if validRoom(request.resource.data, false) && request.resource.data.revision == 1;
      allow update: if validRoom(request.resource.data, request.resource.data.plant.date == resource.data.plant.date
          && request.resource.data.targetWater == resource.data.targetWater)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.plant.get('wateringVersion', 0) >= resource.data.plant.get('wateringVersion', 0)
        && request.resource.data.plant.get('rewardProgressVersion', 0) >= resource.data.plant.get('rewardProgressVersion', 0)
        && request.resource.data.plant.get('balanceVersion', 0) >= resource.data.plant.get('balanceVersion', 0)
        && historyPreserved(resource.data.plant.waterHistoryByDate,
          request.resource.data.plant.waterHistoryByDate, resource.data.plant.date)
        && historyPreserved(resource.data.plant.historyStatusByDate,
          request.resource.data.plant.historyStatusByDate, resource.data.plant.date);
    }
    match /pocket_space/{profile} {
      function role() { return profile == 'user_ppa' ? 'ppa' : 'tbv'; }
      function known() { return profile in ['user_ppa', 'user_tbv']; }
      allow get: if known();
      allow create: if known() && validProfile(request.resource.data, role())
        && request.resource.data.currentActivity == 'home_idle' && mirrored(request.resource.data, role());
      allow update: if known() && validProfile(request.resource.data, role())
        && mirrored(request.resource.data, role()) && validSessionChange(resource.data, request.resource.data, role());
    }
    match /pocket_space/live_interactions/events/{interaction} {
      allow read: if true;
      allow create: if request.resource.data.from in ['ppa', 'tbv']
        && roomAfter().actor == request.resource.data.from
        && request.resource.data.id == interaction
        && request.resource.data.to in ['ppa', 'tbv']
        && request.resource.data.to != request.resource.data.from
        && request.resource.data.type in ['heart', 'kiss', 'punch', 'message', 'quest_request']
        && request.resource.data.content is string && request.resource.data.content.size() <= 500
        && request.resource.data.updatedAt == request.time
        && sameRoomWrite(request.resource.data.roomRevision)
        && (request.resource.data.type != 'quest_request' || request.resource.data.questStatus == 'pending');
      allow update: if roomAfter().actor == resource.data.to && resource.data.type == 'quest_request'
        && resource.data.questStatus == 'pending'
        && request.resource.data.questStatus in ['confirmed', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['questStatus', 'questRespondedAt', 'respondedAt', 'roomRevision', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && sameRoomWrite(request.resource.data.roomRevision);
    }
    match /pocket_space/activity_history/logs/{log} {
      allow read: if true;
      allow create: if request.resource.data.id == log
        && request.resource.data.user in ['ppa', 'tbv']
        && request.resource.data.dateStr.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.startTimestamp is int && request.resource.data.endTimestamp is int
        && request.resource.data.endTimestamp >= request.resource.data.startTimestamp
        && request.resource.data.endTimestamp <= request.time.toMillis() + 120000
        && sameRoomWrite(request.resource.data.roomRevision);
    }
    match /pocket_space/notes_state/days/{noteDay} {
      function validDate(value) {
        return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
      function dayStart(value) {
        let parts = value.split('-');
        return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) - duration.value(7, 'h');
      }
      function validDay(data) {
        return data.owner in ['ppa', 'tbv'] && validDate(data.date)
          && noteDay == data.owner + '_' + data.date
          && data.tasks is map && data.tasks.size() <= 300
          && data.doneIds is list && data.doneIds.size() <= data.tasks.size()
          && data.doneIds.toSet().size() == data.doneIds.size()
          && data.tasks.keys().toSet().hasAll(data.doneIds)
          && data.updatedAt == request.time;
      }
      function canEdit(data) {
        return data.keys().hasOnly(['owner', 'date', 'tasks', 'doneIds', 'pendingDay', 'updatedAt'])
          && data.pendingDay == data.date
          && request.time < dayStart(data.date) + duration.value(1, 'd');
      }
      function carriedIntoToday(before, destination) {
        let unfinished = before.tasks.keys().toSet().difference(before.doneIds.toSet());
        let destId = before.owner + '_' + destination;
        return unfinished.size() == 0
          || getAfter(/databases/$(database)/documents/pocket_space/notes_state/days/$(destId))
            .data.tasks.keys().toSet().hasAll(unfinished);
      }
      function canArchive(before, after) {
        return before.pendingDay == before.date
          && after.keys().hasOnly(['owner', 'date', 'tasks', 'doneIds', 'archivedTo', 'updatedAt'])
          && after.diff(before).affectedKeys().hasOnly(['archivedTo', 'pendingDay', 'updatedAt'])
          && request.time >= dayStart(before.date) + duration.value(1, 'd')
          && validDate(after.archivedTo)
          && request.time >= dayStart(after.archivedTo)
          && request.time < dayStart(after.archivedTo) + duration.value(1, 'd')
          && carriedIntoToday(before, after.archivedTo);
      }

      allow read: if true;
      allow create: if validDay(request.resource.data) && canEdit(request.resource.data);
      allow update: if validDay(request.resource.data)
        && ((resource.data.pendingDay == resource.data.date && canEdit(request.resource.data))
          || canArchive(resource.data, request.resource.data));
    }
  }
}
